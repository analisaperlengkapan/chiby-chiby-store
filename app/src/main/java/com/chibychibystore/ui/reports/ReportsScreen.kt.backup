                            confirmButton = {
                                Button(onClick = {
                                    viewModel.exportCurrentReportToPdf()
                                }) {
                                    Text("Export")
                                }
                            },
                            dismissButton = {
                                TextButton(onClick = { showExportDialog = false }) {
                                    Text("Batal")
                                }
                            }
                        )
                    }
                }
        ) {
            if (uiState.isExporting) {
                CircularProgressIndicator(
                    modifier = Modifier.size(20.dp),
                    strokeWidth = 2.dp
                )
                Spacer(modifier = Modifier.width(8.dp))
                Text("Mengekspor...")
            } else {
                Icon(Icons.Default.Download, contentDescription = "Export")
                Spacer(modifier = Modifier.width(8.dp))
                Text("Export PDF")
            }
        }

        when (data) {
            is CashFlow -> {
                Column {
                    MetricCard(
                        title = "Kas dari Operasi",
                        value = "Rp ${"%,.0f".format(data.operatingCashFlow)}"
                    )
                    MetricCard(
                        title = "Kas dari Investasi",
                        value = "Rp ${"%,.0f".format(data.investingCashFlow)}"
                    )
                    MetricCard(
                        title = "Kas dari Pendanaan",
                        value = "Rp ${"%,.0f".format(data.financingCashFlow)}"
                    )
                    MetricCard(
                        title = "Kenaikan Kas Bersih",
                        value = "Rp ${"%,.0f".format(data.netCashFlow)}"
                    )
                }
            }
            else -> {
                ReportCard(
                    title = "Laporan Arus Kas",
                    content = {
                        Text("Memuat data laporan...")
                    }
                )
            }
        }
    }

    if (showExportDialog) {
        AlertDialog(
            onDismissRequest = { showExportDialog = false },
            title = { Text("Export PDF") },
            text = { Text("Apakah Anda ingin export laporan ini ke PDF?") },
            confirmButton = {
                Button(onClick = {
                    viewModel.exportCurrentReportToPdf()
                }) {
                    Text("Export")
                }
            },
            dismissButton = {
                TextButton(onClick = { showExportDialog = false }) {
                    Text("Batal")
                }
            }
        )
    }
}
